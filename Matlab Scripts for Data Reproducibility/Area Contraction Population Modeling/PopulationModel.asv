%% Population Model of a Time-Varying Hydrogel Parameter, P(t)
%{
    Last Updated: MJB 10/7/2026
%}

classdef PopulationModel < matlab.mixin.Copyable
    %{
        This class creates the population model for the time dependent 
        parameter P(t) as presented in the manuscript. In this model, a 
        sample P_i(t) follows a deterministic exponential time course as:
            P_i(t) = (P_0,i + dP_i) - dP_i e^(-t / tau_i)
        where P_0,i (initial value), dP_i (change in value), and tau_i
        (time constant of the change) are sampled from a population
        (statistical) model. P_0,i and dP_i are jointly distributed as a
        bivariate Normal random variable, and tau_i is distributed as a
        Gamma random variable.

        This model can currently account for effects from a single process
        parameter X, which can impact the mean and standard deviation
        values for each population parameter as a linear function of X. The
        same approach could be extended to accord for nonlinear effects
        from X or effects from multiple process parameters X_i.

    %}
    properties
        include_effect  % binary value to indicate if an processing parameter effect is included.

        mu_P    % mean vector of the bivariate normal distribution on {P_0, dP}
        cov_P   % covariance matrix on {P_0, dP}
        
        mu_tau     % mean for the Gamma distribution on tau
        sig_tau    % std for the Gamma distribution on tau

        % Effect functions: these are function of a process parameter X
        % that impacts the population parameters
        mu_P_effect   % effect matrix on mu_P
        cov_P_effect  % effect matrix on sig_P
        mu_tau_effect   % effect scalar on mu_tau
        sig_tau_effect  % effect scalar on sig_tau

    end

    methods
        function obj = PopulationModel(include_effect)

            % determining if the model includes a processing parameter
            % effect
            obj.include_effect = include_effect;

            % initializing parameters
            obj.mu_P = [0;0];
            obj.cov_P = diag([1,1]);

            obj.mu_tau = 1;
            obj.sig_tau = 1;

            obj.mu_P_effect = @(X) diag([1,1]);
            obj.cov_P_effect = @(X) diag([1,1]);
            obj.mu_tau_effect = @(X) 1;
            obj.sig_tau_effect = @(X) 1;
        end

        function setParams(obj,theta)
            % mu_P
            mu_P0 = theta(1); mu_dP = theta(2);
            obj.set_mu_P(mu_P0,mu_dP);
            
            % sig_P
            sig_P0 = theta(3); sig_dP = theta(4); rho_ = theta(5);
            obj.set_cov_P(sig_P0,sig_dP,rho_);
            
            % tau params
            mu_tau_ = theta(6); sig_tau_ = theta(7);
            obj.set_tau_params(mu_tau_,sig_tau_);

            if obj.include_effect
                % effect functions
                alpha_mu = theta(8); alpha_sig = theta(9);
                obj.set_P_effect(alpha_mu,alpha_sig);
    
                beta_mu = theta(10); beta_sig = theta(11);
                obj.set_tau_effect(beta_mu,beta_sig);
            end
        end
        
        % functions used to set individual parameters without having to
        % reset the entire parameter vector
        function set_mu_P(obj, mu_P0,mu_dP)
            obj.mu_P = [mu_P0; mu_dP];
        end
        function set_cov_P(obj, sig_P0,sig_dP,rho)
            sig_P = diag([sig_P0,sig_dP]);
            rho = [1, rho; rho, 1];
            obj.cov_P = sig_P * rho * sig_P;
        end
        function set_P_effect(obj,alpha_mu,alpha_sig)
            obj.mu_P_effect = @(X) [1,0; 0, 1+alpha_mu*X];
            obj.cov_P_effect = @(X) [1,0; 0, 1+alpha_sig*X];
        end

        function set_tau_params(obj,mu_tau,sig_tau)
            obj.mu_tau = mu_tau;
            obj.sig_tau = sig_tau;
        end
        function set_tau_effect(obj,beta_mu,beta_sig)
            obj.mu_tau_effect = @(X) 1 + beta_mu*X;
            obj.sig_tau_effect = @(X) 1 + beta_sig*X;
        end


        % functions to generate data from the model
        function params = rnd_params(obj,N,X)
            % generate N random sets of parameters {P_0, dP, tau} given a
            % single process condition X
            if length(X)~=1
                error("'X' must be a scalar value, not a vector. For control group, set X=0.")
                params = nan*zeros(N,1);
                return
            end
            
            % construct parameters for particular value of X
            mu_P_X = obj.mu_P_effect(X)*obj.mu_P;
            cov_P_X = obj.cov_P_effect(X) * obj.cov_P * obj.cov_P_effect(X);
            mu_tau_X = obj.mu_tau_effect(X) * obj.mu_tau;
            sig_tau_X = obj.sig_tau_effect(X) * obj.sig_tau;

            % sampling parameters from a bivariate normal
            P_vec = mvnrnd(mu_P_X,cov_P_X,N);

            % sampling parameters from a Gamma distribution
            tau_alpha = (mu_tau_X/sig_tau_X)^2; tau_beta = sig_tau_X^2 / mu_tau_X;
            tau_vec = gamrnd(tau_alpha,tau_beta,N,1);
            
            params = [P_vec, tau_vec];
        end

        function [P_t,params] = rnd_trajectories(obj,t,N,X)
            % generate N random trajectories P(t) given a single process
            % condition. Also returns the parameters used to generate the
            % trajectories.
            if length(X)~=1
                error("'X' must be a scalar value, not a vector. For control group, set X=0.")
                params = nan*zeros(N,length(t));
                return
            end
            
            % generate the parameters for the random trajectories
            params = obj.rnd_params(N,X);

            % generate the trajectories
            P_t = (params(:,1) + params(:,2)) - params(:,2).*exp(-t ./ params(:,3));
        end


        function log_p = log_pdf(obj,theta,X)
            % calculates the log pdf for a given set of parameter data 
            % (theta={P0,dP,tau}) given a single process condition X. theta
            % needs to be of the size Nx3
            if length(X)~=1
                error("'X' must be a scalar value, not a vector. For control group, set X=0.")
                params = nan*zeros(length(theta),1);
                return
            end
            if size(theta,2)~=3
                error("'theta' must be in the shape Nx3, where each row is a different sample of theta.")
            end

            % construct parameters for particular value of X
            mu_P_X = obj.mu_P_effect(X)*obj.mu_P;
            cov_P_X = obj.cov_P_effect(X) * obj.cov_P * obj.cov_P_effect(X);
            mu_tau_X = obj.mu_tau_effect(X) * obj.mu_tau;
            sig_tau_X = obj.sig_tau_effect(X) * obj.sig_tau;
            
            % breaking out the data
            P_data = theta(:,1:2); tau_data = theta(:,3);
            
            % log probability of P data
            log_p_P = mvnpdf(P_data, mu_P_X, cov_P_X,'Log',true);
            
            % log probability of tau data
            tau_alpha = (mu_tau_X/sig_tau_X)^2; tau_beta = sig_tau_X^2 / mu_tau_X;
            log_p_tau = gampdf(tau_data,tau_alpha,tau_beta,'Log',true);
            
            % total log probability is sum because tau and P are
            % independent
            log_p = log_p_P + log_p_tau;
        end

        function p = pdf(obj,theta,X)
            % calculates the pdf for a given set of parameter data 
            % (theta={P0,dP,tau}) given a single process condition X. theta
            % needs to be of the size Nx3
            p = exp(obj.log_pdf(theta,X));    
        end

        function log_L = log_likelihood_group(obj,theta,X)
            % calculates the log likelihood for a given dataset of data 
            % (theta_i={P0,dP,tau}) given a single process condition X. 
            % theta needs to be of the size Nx3. This function assumes that
            % the different samples are independent such that the
            % likelihood is equal to the product of the probability of each
            % individual sample.
            log_L = sum(obj.log_pdf(theta,X));
        end

        function L = likelihood_group(obj,theta,X)
            % calculates the likelihood for a given dataset of data 
            % (theta_i={P0,dP,tau}) given a single process condition X. 
            % theta needs to be of the size Nx3. This function assumes that
            % the different samples are independent such that the
            % likelihood is equal to the product of the probability of each
            % individual sample.
            L = exp(obj.log_likelihood_group(theta,X));
        end

        function log_L = log_likelihood(obj,theta)
            % calculates the likelihood for a given dataset of data 
            % (theta_i={X,P0,dP,tau}) where X is the processing condition 
            % for the particular row. This function is compatible with the 
            % SMC_Sampler class used to estimate the parameters.
            
            % theta needs to be of the size Nx4. This function assumes that
            % the different samples are independent such that the
            % likelihood is equal to the product of the probability of each
            % individual sample.
            if size(theta,2)~=4
                error("'theta' must be in the shape Nx4, where each row is a different sample of theta.")
            end

            % breaking o
            X_ = theta(:,1);
            theta_ = theta(:,2:4);

            

        end

    end


end